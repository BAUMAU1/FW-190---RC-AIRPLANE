// This code is written for the Gulikit KK3 Pro controller and may not work with every controller-protocol right off the bat
// Two DX-LR03 antennas and two ESP32 S3 needed for connection.
// Receiver ESP has its own code.
// Wiring of the antennas:
// M0 -> LOW, M1 -> HIGH, VCC -> 5V, TX -> Pin 18, RX -> Pin 17, GND -> GND

#include "EspUsbHost.h"
#include "DXLR03.h"

EspUsbHost usb;
DXLR03 lora(Serial1, 18, 17, 115200);

struct controllerdata
{
  uint8_t RX;
  uint8_t RY;
  uint8_t LX;
  uint8_t LY;
  uint8_t ZR;
  uint8_t ZL;
  uint8_t Btna;
  uint8_t Btnb;
};

controllerdata packet = {};

void sendPacket()
{
  lora.send(reinterpret_cast<uint8_t *>(&packet), sizeof(packet));
}

