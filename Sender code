// for dongle connection
   usb.onHIDInput([](const EspUsbHostHIDInput &event)
  {
   if (event.length < 9) 
    {
      return;
    }

    packet.RX = event.data[1]; //5
    packet.RY = event.data[2]; //6
    packet.LX = event.data[3];
    packet.LY = event.data[4];
    packet.ZR = event.data[7];
    packet.ZL = event.data[8];
    packet.Btna = (event.data[0] & 0x02) ? 1 : 0;
    packet.Btnb = (event.data[0] & 0x01) ? 1 : 0;

    Serial.printf("TX -> RX:%u RY:%u LX:%u LY:%u ZR:%u ZL:%u Btna:%u Btnb:%u\n",
                  packet.RX, packet.RY, packet.LX, packet.LY,
                  packet.ZR, packet.ZL, packet.Btna, packet.Btnb);

    sendPacket();
  });
  if (!usb.begin())
  {
    Serial.printf("usb.begin() failed: %s\n", usb.lastErrorName());
  }

}
void loop()
{
  lora.poll();
  delay(5);
}
